+                  "slug": "gpt-5.6-sol",
+                  "display_name": "GPT-5.6 Sol",
+                  "supported_in_api": true,
+                  "visibility": "list"
+                },
+                {
+                  "slug": "hidden-model",
+                  "supported_in_api": true,
+                  "visibility": "hide"
+                },
+                {
+                  "slug": "unsupported-model",
+                  "supported_in_api": false,
+                  "visibility": "list"
